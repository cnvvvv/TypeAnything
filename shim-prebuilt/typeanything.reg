Windows Registry Editor Version 5.00

; ═══════════════════════════════════════════════════════════════
; TypeAnything TSF 输入法注册表
; 双击此文件导入，或管理员命令：regedit /s typeanything.reg
;
; CLSID_TIP       = {E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}
; CLSID_Profile   = {E5B3C8A2-2D4F-4A6B-9C3D-7E8F1A2B4C6D}
; GUID_TFCAT_TIP_KEYBOARD = {34745C63-B2F0-4784-8B67-5E12C8701A31}
; LANGID zh-CN    = 00000804
; ═══════════════════════════════════════════════════════════════

; ─── 1. HKCR\CLSID — COM 类注册 ───────────────────────────────
[HKEY_CLASSES_ROOT\CLSID\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}]
@="TypeAnything"

[HKEY_CLASSES_ROOT\CLSID\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}\InprocServer32]
@="D:\\UGit\\TypeAnything\\shim-prebuilt\\WeaselTSFShim.dll"
"ThreadingModel"="Apartment"

; ─── 2. HKLM\SOFTWARE\Microsoft\CTF\TIP — TSF 输入法主体 ──────
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\CTF\TIP\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}]
@="TypeAnything"
"IconIndex"=dword:00000000
"Enable"=dword:00000001

; ─── 3. LanguageProfile — 语言配置文件 ─────────────────────────
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\CTF\TIP\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}\LanguageProfile]
@="{E5B3C8A2-2D4F-4A6B-9C3D-7E8F1A2B4C6D}"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\CTF\TIP\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}\LanguageProfile\{E5B3C8A2-2D4F-4A6B-9C3D-7E8F1A2B4C6D}]
@="TypeAnything"
"Description"="TypeAnything - 五笔输入+AI翻译"
"Reserved"=dword:00000000

; ─── 4. Category\Category — TIP 类别（keyboard） ──────────────
; 注册到 TFCAT_TIP_KEYBOARD，让 Windows 把它当输入法处理
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\CTF\TIP\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}\Category\Category\{34745C63-B2F0-4784-8B67-5E12C8701A31}\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}]

; ─── 5. Category\Item — TIP 项 ────────────────────────────────
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\CTF\TIP\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}\Category\Item\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}\{34745C63-B2F0-4784-8B67-5E12C8701A31}]

; ─── 6. 显示描述（HKCU） ──────────────────────────────────────
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\CTF\TIP\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}\LanguageProfile\{E5B3C8A2-2D4F-4A6B-9C3D-7E8F1A2B4C6D}\DisplayDescription]
@="TypeAnything - 五笔输入+AI翻译"

; ─── 7. 在 zh-CN 语言下注册 profile（让"中文"设置里能看到） ───
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\CTF\KnownLanguageProfiles]
"{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}"="00000804"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\CTF\KnownLanguageProfiles\{E5B3C8A1-2D4F-4A6B-9C3D-7E8F1A2B4C6D}\00000804]
"0"="{E5B3C8A2-2D4F-4A6B-9C3D-7E8F1A2B4C6D}"
"Description"="TypeAnything"
"Reserved"=dword:00000000
